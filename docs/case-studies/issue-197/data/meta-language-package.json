{
  "name": "meta-language",
  "version": "1.0.0",
  "description": "JavaScript implementation of the meta-language links-network core",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "meta-language": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "npm run check:parity && npm run check:export-parity && npm run check:default-cst && npm run check:lino-grammar && npm run check:pdf-grammar && npm run check:native-imports && npm run check:native-grammars && npm run check:builtin-cst && npm run check:language-catalog && npm run check:concept-records && npm run check:concept-reuse && npm run check:merge-quality && npm run check:foundations && npm run check:issue-195 && npm run check:issue-195:sources && npm run check:downstream-consumers && npm run check:dependencies && npm run check:naming && npm run check:documentation && npm run check:self-translation && npm run check:frontend-rules",
    "check:parity": "node scripts/check-js-rust-parity.mjs",
    "check:parity:manifest": "node scripts/check-js-rust-parity.mjs --manifest-only",
    "check:issue-195": "node scripts/check-issue-195-acceptance.mjs",
    "check:issue-195:sources": "node scripts/check-issue-195-sources.mjs",
    "check:issue-195:merge-enforcement": "node scripts/check-issue-195-merge-enforcement.mjs",
    "check:downstream-consumers": "node scripts/check-downstream-consumers.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:dependencies:delivery": "node scripts/check-dependencies.mjs --delivery",
    "dependencies:refresh": "node scripts/check-dependencies.mjs --refresh",
    "check:documentation": "node scripts/check-documentation.mjs",
    "check:default-cst": "node scripts/generate-default-cst-expectations.mjs --check",
    "check:self-translation": "node scripts/generate-self-translation-cases.mjs --check",
    "check:frontend-rules": "node scripts/generate-frontend-rules.mjs --check",
    "check:lino-grammar": "node scripts/generate-lino-grammar-cases.mjs --check",
    "check:pdf-grammar": "node scripts/generate-pdf-grammar-cases.mjs --check",
    "check:native-imports": "node scripts/import-native-grammars.mjs --check",
    "check:native-grammars": "node scripts/generate-native-grammar-fixtures.mjs --check",
    "check:builtin-cst": "node scripts/generate-builtin-cst-expectations.mjs --check",
    "check:language-catalog": "node scripts/build-language-catalog.mjs --check",
    "check:concept-records": "node scripts/build-concept-records.mjs --check",
    "check:concept-reuse": "node scripts/build-native-grammar-concept-reuse.mjs --check",
    "check:merge-quality": "node scripts/build-merge-quality-evidence.mjs --check",
    "check:foundations": "node scripts/build-foundation-models.mjs --check",
    "check:export-parity": "node scripts/generate-export-parity.mjs --check",
    "check:issue-195:runtime-parity": "node scripts/check-issue-195-runtime-parity.mjs",
    "acceptance:issue-195": "node scripts/check-issue-195-acceptance.mjs --produce-gate-results issue-195-results/gate-faults.json --evaluate --checkpoint all",
    "acceptance:issue-195:refresh": "node scripts/check-issue-195-acceptance.mjs --refresh-manifest"
  },
  "keywords": [
    "links",
    "language",
    "cst",
    "ast",
    "lino"
  ],
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/meta-language.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "links-notation": "0.22.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "franc-min": "6.2.0",
    "pdf-lib": "1.17.1",
    "peggy": "5.1.0",
    "wordnet-db": "3.1.14"
  },
  "overrides": {
    "@peggyjs/from-mem": "3.1.4",
    "commander": "15.0.0",
    "source-map-generator": "2.0.7",
    "semver": "7.8.5",
    "pako": "3.0.2",
    "tslib": "2.8.1"
  }
}

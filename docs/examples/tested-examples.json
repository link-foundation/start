{
  "version": 1,
  "examples": [
    {
      "id": "direct-echo",
      "title": "Direct command logging",
      "references": [
        {
          "file": "README.md",
          "text": "$ echo \"Hello World\""
        },
        {
          "file": "docs/EXAMPLES.md",
          "text": "$ echo \"Hello World\""
        },
        {
          "file": "docs/EXAMPLES.md",
          "text": "start echo \"Hello World\""
        },
        {
          "file": "js/README.md",
          "text": "$ echo \"Hello World\""
        },
        {
          "file": "rust/README.md",
          "text": "start echo \"Hello World\""
        }
      ],
      "commands": {
        "js": {
          "argv": ["echo", "Hello World"]
        },
        "rust": {
          "argv": ["echo", "Hello World"]
        }
      },
      "expectedNormalizedStdout": "\u2502 session   <uuid>\n\u2502 start     <timestamp>\n\u2502\n$ echo \"Hello World\"\n\nHello World\n\n\u2713\n\u2502 finish    <timestamp>\n\u2502 duration  <duration>\n\u2502 exit      0\n\u2502\n\u2502 log       <log-path>\n\u2502 session   <uuid>\n"
    },
    {
      "id": "docker-box-js",
      "title": "Docker isolation with box-js",
      "references": [
        {
          "file": "README.md",
          "text": "$ --isolated docker --image ghcr.io/link-foundation/box-js:latest -- bun --version"
        },
        {
          "file": "docs/EXAMPLES.md",
          "text": "$ --isolated docker --image ghcr.io/link-foundation/box-js:latest -- bun --version"
        },
        {
          "file": "examples/docker-isolation-box.sh",
          "text": "--image ghcr.io/link-foundation/box-js:latest"
        }
      ],
      "parseOnly": {
        "argv": [
          "--isolated",
          "docker",
          "--image",
          "ghcr.io/link-foundation/box-js:latest",
          "--",
          "bun",
          "--version"
        ],
        "expected": {
          "isolated": "docker",
          "image": "ghcr.io/link-foundation/box-js:latest",
          "command": "bun --version"
        },
        "reason": "Executing this example requires Docker and may pull a large image, so CI verifies the documented command is present and parser-compatible."
      }
    },
    {
      "id": "docker-default-image",
      "title": "Docker isolation default image",
      "references": [
        {
          "file": "README.md",
          "text": "$ --isolated docker -- echo \"hello from docker\""
        },
        {
          "file": "docs/EXAMPLES.md",
          "text": "$ --isolated docker -- echo \"hello from docker\""
        }
      ],
      "parseOnly": {
        "argv": ["--isolated", "docker", "--", "echo", "hello from docker"],
        "expected": {
          "isolated": "docker",
          "command": "echo 'hello from docker'"
        },
        "requiresImage": true,
        "reason": "The default image depends on the host OS; parser validation checks that an image is assigned."
      }
    },
    {
      "id": "status-json",
      "title": "Execution list as JSON",
      "references": [
        {
          "file": "README.md",
          "text": "$ --list --output-format json"
        },
        {
          "file": "docs/EXAMPLES.md",
          "text": "$ --list --output-format json"
        }
      ],
      "parseOnly": {
        "argv": ["--list", "--output-format", "json"],
        "expected": {
          "list": true,
          "outputFormat": "json",
          "command": ""
        },
        "reason": "List output depends on the user's local execution store."
      }
    },
    {
      "id": "docker-resource-controls",
      "title": "Finite Docker resource controls",
      "references": [
        {
          "file": "README.md",
          "text": "--memory 64m --cpus 1"
        },
        {
          "file": "examples/docker-resource-controls.sh",
          "text": "--memory 64m --cpus 1"
        }
      ],
      "parseOnly": {
        "argv": [
          "-i",
          "docker",
          "-d",
          "--image",
          "alpine",
          "--memory",
          "64m",
          "--cpus",
          "1",
          "--",
          "sleep",
          "30"
        ],
        "expected": {
          "isolated": "docker",
          "memory": "64m",
          "cpus": "1",
          "command": "sleep 30"
        },
        "reason": "Resource enforcement requires usable daemon cgroup controllers. Dedicated JS/Rust regression suites validate resolution and command ordering, and the finite real-Docker probe checks enforcement where supported."
      }
    }
  ]
}

{
  "name": "start-command",
  "version": "0.39.2",
  "description": "Gamification of coding, execute any command with ability to auto-report issues on GitHub",
  "main": "src/bin/cli.js",
  "exports": {
    ".": "./src/bin/cli.js",
    "./execution-store": "./src/lib/execution-store.js"
  },
  "bin": {
    "$": "./src/bin/cli.js"
  },
  "scripts": {
    "test": "bun ../scripts/run-js-tests.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "bun ../scripts/check-file-size.mjs",
    "lint:scripts": "cd .. && eslint . --max-warnings 0",
    "format:check:scripts": "cd .. && prettier --check \"scripts/**/*.{js,mjs,cjs}\"",
    "check": "bun run lint && bun run lint:scripts && bun run format:check && bun run format:check:scripts && bun run check:file-size",
    "prepare": "cd .. && husky .husky || true",
    "changeset": "changeset",
    "changeset:version": "bun ../scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "cli",
    "command",
    "gamification",
    "github",
    "automation"
  ],
  "author": "",
  "license": "Unlicense",
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/start.git"
  },
  "bugs": {
    "url": "https://github.com/link-foundation/start/issues"
  },
  "homepage": "https://github.com/link-foundation/start#readme",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "dependencies": {
    "@link-foundation/sensitive-data-sanitizer": "^0.12.2",
    "command-stream": "^2.6.0",
    "lino-objects-codec": "^0.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "flatted": "^3.4.4"
  }
}

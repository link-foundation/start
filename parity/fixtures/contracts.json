  "cli-parsing": [
    {
      "name": "plain argv",
      "argv": [
        "echo",
        "hello"
      ],
      "command": "echo hello",
      "rawCommand": [
        "echo",
        "hello"
      ],
      "options": {
        "isolated": null,
        "detached": false,
        "status": null
      }
    },
    {
      "name": "explicit tmux separator",
      "argv": [
        "--isolated=tmux",
        "-d",
        "--session",
        "fixture-session",
        "--",
        "echo",
        "hello"
      ],
      "command": "echo hello",
      "rawCommand": [
        "echo",
        "hello"
      ],
      "options": {
        "isolated": "tmux",
        "detached": true,
        "session": "fixture-session"
      }
    },
    {
      "name": "query without command",
      "argv": [
        "--status",
        "fixture-session",
        "--output-format",
        "json"
      ],
      "command": "",
      "rawCommand": [],
      "options": {
        "status": "fixture-session",
        "outputFormat": "json"
      }
    },
    {
      "name": "docker resource flags",
      "argv": [
        "--isolated",
        "docker",
        "--memory=256m",
        "--cpus=1.5",
        "--",
        "echo",
        "hello"
      ],
      "command": "echo hello",
      "rawCommand": [
        "echo",
        "hello"
      ],
      "options": {
        "isolated": "docker",
        "memory": "256m",
        "cpus": "1.5"
      }
    },
    {
      "name": "unknown wrapper option",
      "argv": [
        "--definitely-unknown"
      ],
      "error": "Unknown wrapper option"
    },
    {
      "name": "conflicting modes",
      "argv": [
        "--attached",
        "--detached",
        "--",
        "echo"
      ],
      "error": "attached"
    },
    {
      "name": "snapshot resume options (issue #224)",
      "argv": [
        "--resume",
        "fixture-session",
        "--snapshot-wait",
        "600",
        "--snapshot-disk-wait=1800",
        "--remove-original-after",
        "30",
        "--snapshot-size-hint=12g",
        "--snapshot-prepare",
        "rm -rf /tmp/cache"
      ],
      "command": "",
      "rawCommand": [],
      "options": {
        "resume": "fixture-session",
        "snapshotWait": 600,
        "snapshotDiskWait": 1800,
        "removeOriginalAfter": 30,
        "snapshotSizeHint": 12884901888,
        "snapshotPrepare": "rm -rf /tmp/cache",
        "removeOriginal": true
      }
    },
    {
      "name": "cleanup of one execution (issue #224)",
      "argv": [
        "--cleanup-dry-run",
        "fixture-session"
      ],
      "command": "",
      "rawCommand": [],
      "options": {
        "cleanup": true,
        "cleanupDryRun": true,
        "cleanupTarget": "fixture-session"
      }
    },
    {
      "name": "snapshot options outside --resume (issue #224)",
      "argv": [
        "--snapshot-wait=5",
        "--",
        "echo"
      ],
      "error": "--snapshot-wait is only valid with --resume"
    },
    {
      "name": "Docker soft memory 64m (issue #236)",
      "argv": [
        "--isolated",
        "docker",
        "--memory",
        "256m",
        "--memory-reservation",
        "64m",
        "--",
        "echo",
        "hi"
      ],
      "command": "echo hi",
      "rawCommand": [
        "echo",
        "hi"
      ],
      "options": {
        "memory": "256m",
        "memoryReservation": "64m"
      },
      "dockerResourceLimits": [
        "--memory=268435456",
        "--memory-reservation=67108864",
        "--memory-swap=268435456"
      ]
    },
    {
      "name": "Docker soft memory --memory-reservation=25% (issue #236)",
      "argv": [
        "--isolated",
        "docker",
        "--memory",
        "256m",
        "--memory-reservation=25%",
        "--",
        "echo",
        "hi"
